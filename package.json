          <div className="grid grid-cols-3 gap-4">
            {['small', 'medium', 'large'].map((size) => (
              <button key={size} type="button" onClick={() => setCustomOrder({ ...customOrder, size })} className={`p-4 rounded-2xl border-2 capitalize font-bold transition-all ${customOrder.size === size ? 'border-emerald-800 bg-emerald-50' : 'border-stone-100'}`}>
                {size}
              </button>
            ))}
          </div>
          <div onClick={() => fileInputRef.current?.click()} className="border-2 border-dashed border-stone-200 rounded-[2rem] p-10 text-center cursor-pointer hover:border-emerald-400 transition-all">
            <input type="file" hidden ref={fileInputRef} accept="image/*" onChange={(e) => { const f = e.target.files[0]; if(f) setCustomOrder({...customOrder, image: f, imagePreview: URL.createObjectURL(f)}); }} />
            {customOrder.imagePreview ? <img src={customOrder.imagePreview} className="max-h-64 mx-auto rounded-xl shadow-lg" alt="Preview" /> : <p className="font-bold text-stone-400 uppercase text-xs tracking-widest">Click to Upload Photo</p>}
          </div>
          <div className="bg-emerald-50 p-6 rounded-2xl border border-emerald-100 flex gap-4">
            <Clock className="w-6 h-6 text-emerald-700 flex-shrink-0" />
            <p className="text-sm text-emerald-900 leading-relaxed italic">Once submitted, I will personally reach out within <span className="font-bold">48 hours</span> with a final quote and estimated completion date for your commission.</p>
          </div>
          <button type="button" className="w-full py-5 bg-emerald-900 text-white rounded-2xl font-bold">Send Commission Request</button>
        </form>
        <div className="lg:col-span-2 space-y-8"><div className="bg-[#1a2e1a] text-white p-8 rounded-[2.5rem]"><h3 className="font-serif text-xl mb-4">Photo Guide</h3><ul className="space-y-4 text-sm opacity-90"><li className="flex gap-3"><CheckCircle2 className="w-4 h-4 text-emerald-400 flex-shrink-0" /> Natural lighting is best.</li><li className="flex gap-3"><CheckCircle2 className="w-4 h-4 text-emerald-400 flex-shrink-0" /> High contrast silhouettes work well.</li></ul></div></div>
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-[#fdfaf6] font-sans text-stone-900 selection:bg-emerald-100">
      <svg style={{ position: 'absolute', width: 0, height: 0 }} aria-hidden="true" focusable="false">
        <filter id="crochetFilter">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
          <feMorphology operator="dilate" radius="0.5" />
        </filter>
      </svg>

      <header className={`fixed top-0 left-0 right-0 z-[100] transition-all duration-300 ${isScrolled || isMenuOpen ? 'bg-white shadow-sm py-3' : 'bg-transparent py-6'}`}>
        <nav className="max-w-6xl mx-auto px-6 flex items-center justify-between">
          <div onClick={() => navigateTo('home')} className="text-2xl font-serif text-stone-800 cursor-pointer flex items-center gap-2 group">
            <div className="w-9 h-9 bg-emerald-900 rounded-xl flex items-center justify-center text-emerald-50"><Scissors className="w-5 h-5" /></div>
            <span className="tracking-tight">Soul of <span className="text-emerald-800">Crochet</span></span>
          </div>

          <div className="hidden md:flex items-center space-x-8">
            <button onClick={() => navigateTo('home')} className="text-sm font-semibold text-stone-600 hover:text-emerald-800">Home</button>
            <div className="relative" ref={dropdownRef}>
              <button 
                onClick={() => setShowDesktopDropdown(!showDesktopDropdown)}
                className={`flex items-center gap-1 text-sm font-semibold transition-colors py-2 ${showDesktopDropdown ? 'text-emerald-800' : 'text-stone-600 hover:text-emerald-800'}`}
              >
                Impact <ChevronDown className={`w-4 h-4 transition-transform ${showDesktopDropdown ? 'rotate-180' : ''}`} />
              </button>
              
              {showDesktopDropdown && (
                <div className="absolute top-full right-0 mt-2 w-64 bg-white border border-stone-200 rounded-2xl shadow-2xl py-3 animate-in fade-in zoom-in-95 duration-200">
                  {menuItems.map((item) => (
                    <button 
                      key={item.id} 
                      onClick={() => navigateTo(item.id)} 
                      className="w-full text-left px-5 py-3 text-sm text-stone-600 hover:text-emerald-800 hover:bg-emerald-50/50 flex items-center gap-3 transition-colors"
                    >
                      <item.icon className="w-4 h-4 text-emerald-700/60" />
                      {item.label}
                    </button>
                  ))}
                </div>
              )}
            </div>
            <button onClick={() => navigateTo('custom')} className="px-6 py-2.5 bg-emerald-900 text-white text-sm font-bold rounded-full hover:bg-emerald-950 transition-colors">Custom Order</button>
          </div>

          <button className="md:hidden p-2 text-stone-700 z-[110]" onClick={() => setIsMenuOpen(!isMenuOpen)}>
            {isMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
          </button>
        </nav>

        {isMenuOpen && (
          <div className="md:hidden absolute top-0 left-0 right-0 h-screen bg-white z-[105] animate-in slide-in-from-top duration-300">
            <div className="flex flex-col p-10 pt-24 space-y-4">
              <button onClick={() => navigateTo('home')} className="flex items-center gap-4 py-4 text-xl font-bold text-stone-800 border-b border-stone-50"><Home className="w-6 h-6 text-emerald-800" /> Home</button>
              {menuItems.map((item) => (
                <button key={item.id} onClick={() => navigateTo(item.id)} className="flex items-center gap-4 py-4 text-xl font-medium text-stone-600 border-b border-stone-50"><item.icon className="w-6 h-6 text-emerald-700" /> {item.label}</button>
              ))}
              <button onClick={() => navigateTo('custom')} className="mt-8 py-5 bg-emerald-900 text-white rounded-2xl text-lg font-bold">Custom Order</button>
            </div>
          </div>
        )}
      </header>

      <main className="relative">
        {currentPage === 'home' && <HomeSection />}
        {currentPage === 'tapestries' && <TapestryGallery />}
        {currentPage === 'research' && <ResearchSection />}
        {currentPage === 'donations' && <DonationSection />}
        {currentPage === 'custom' && <CustomSection />}
      </main>

      <footer className="bg-[#1a2e1a] text-emerald-100 py-12 px-6 mt-20">
        <div className="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
          <h3 className="font-serif text-2xl text-emerald-50">Soul of Crochet</h3>
          <div className="flex space-x-8"><Instagram className="w-5 h-5" /><Mail className="w-5 h-5" /></div>
          <p className="text-xs opacity-60">© 2024 Soul of Crochet. Earthy Art for a Better World.</p>
        </div>
      </footer>
    </div>
  );
};

export default App;

"homepage": "https://sbynum-cpu.github.io/first-repository-/",

"scripts": {
  "start": "react-scripts start",
  "build": "react-scripts build",
  "test": "react-scripts test",
  "eject": "react-scripts eject",
  "predeploy": "npm run build",
  "deploy": "gh-pages -d build"
},

import React, { useState, useEffect, useRef } from 'react';
import { 
  Menu, 
  ChevronDown, 
  Heart, 
  Search, 
  Scissors, 
  Instagram, 
  Mail, 
  ArrowLeft, 
  ArrowRight, 
  CheckCircle2, 
  PawPrint, 
  Microscope, 
  ScrollText, 
  Home, 
  ShieldCheck, 
  Stethoscope, 
  CreditCard, 
  Target,
  Upload,
  Image as ImageIcon,
  X,
  Info,
  Maximize,
  Sparkles,
  LayoutGrid,
  ShoppingBag,
  Clock
} from 'lucide-react';

const App = () => {
  const [currentPage, setCurrentPage] = useState('home');
  const [selectedDisease, setSelectedDisease] = useState(null);
  const [selectedTapestry, setSelectedTapestry] = useState(null);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [isScrolled, setIsScrolled] = useState(false);
  const [isAdmin, setIsAdmin] = useState(false);
  const [detailSize, setDetailSize] = useState('medium');
  const [showDesktopDropdown, setShowDesktopDropdown] = useState(false);

  const [customOrder, setCustomOrder] = useState({
    name: '',
    email: '',
    size: 'medium',
    image: null,
    imagePreview: null
  });
  const fileInputRef = useRef(null);
  const dropdownRef = useRef(null);

  const [progress, setProgress] = useState({
    wildlife: 145,
    shelters: 80,
    research: 120
  });
  const GOAL = 200;

  const tapestries = [
    { id: 1, name: "The Stallion", species: "Horse", basePrice: 120, img: "https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?q=80&w=800&auto=format&fit=crop" },
    { id: 2, name: "Forest Guardian", species: "Deer", basePrice: 110, img: "https://images.unsplash.com/photo-1484406566174-9da000fda645?q=80&w=800&auto=format&fit=crop" },
    { id: 3, name: "Midnight Howl", species: "Wolf", basePrice: 130, img: "https://images.unsplash.com/photo-1555181964-7bb515a7b81e?q=80&w=800&auto=format&fit=crop" },
    { id: 4, name: "Graceful Feline", species: "Cat", basePrice: 100, img: "https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?q=80&w=800&auto=format&fit=crop" },
    { id: 5, name: "Steady Trunk", species: "Elephant", basePrice: 150, img: "https://images.unsplash.com/photo-1557050543-4d5f4e07ef46?q=80&w=800&auto=format&fit=crop" },
    { id: 6, name: "Alpine Ascent", species: "Mountain Goat", basePrice: 115, img: "https://images.unsplash.com/photo-1521652127902-3cdd4ee1bbcf?q=80&w=800&auto=format&fit=crop" },
  ];

  const sizeMultipliers = {
    small: 1,
    medium: 1.8,
    large: 3.2
  };

  const sizeLabels = {
    small: '12" x 12"',
    medium: '24" x 24"',
    large: '36" x 36"'
  };

  const diseaseData = [
    { 
      id: "hcm", 
      title: "Feline Hypertrophic Cardiomyopathy (HCM)", 
      shortDesc: "The most common heart disease in cats, often hereditary.", 
      fullDescription: "Hypertrophic cardiomyopathy (HCM) is a complex cardiovascular condition where the muscular walls of the heart—specifically the left ventricle—become abnormally thickened (hypertrophied). This thickening reduces the heart's internal volume and prevents the muscle from relaxing properly between beats. Over time, this leads to oxygen-deprived heart tissue and can cause heart failure, lethal arrhythmias, or the formation of blood clots that may lead to sudden paralysis (Saddle Thrombus). Diagnosis usually requires specialized echocardiography to measure the wall thickness.", 
      homeCare: "While HCM cannot be cured, managing the environment is key. Ensure your cat has a low-stress, quiet environment to rest. Monitor their resting respiratory rate while sleeping; a rate consistently over 30 breaths per minute may indicate fluid buildup in the lungs. Regular medication schedules for beta-blockers or ACE inhibitors are vital.", 
      partners: "We proudly donate a portion of our 'Feline Soul' collection proceeds to the EveryCat Health Foundation." 
    },
    { 
      id: "ccd", 
      title: "Canine Cognitive Dysfunction (CCD)", 
      shortDesc: "Similar to Alzheimer's, affecting aging dogs' quality of life.", 
      fullDescription: "Canine Cognitive Dysfunction is a neurodegenerative disorder linked to the age-related accumulation of amyloid plaques and tau proteins in the brain, very similar to Alzheimer’s disease in humans. This results in significant changes in behavior, memory, and learning. It often manifests as 'DISHA' symptoms: Disorientation, altered Interactions, Sleep-wake cycle changes, House-soiling, and Activity level changes. It is a progressive condition that significantly impacts the bond between a pet and its owner as the dog may eventually stop recognizing familiar faces.", 
      homeCare: "Mental stimulation is the best support at home. Use puzzle feeders and gentle 'nose work' games to keep the brain engaged. Maintain a strict daily routine to reduce anxiety and avoid rearranging furniture, which can cause confusion for disoriented senior dogs. Supplementing with Omega-3 fatty acids and antioxidants can also provide neuroprotective benefits.", 
      partners: "Proceeds from our 'Senior Paws' tapestry series are directed to the Canine Cognition Center at Duke University." 
    },
    { 
      id: "ems", 
      title: "Equine Metabolic Syndrome (EMS)", 
      shortDesc: "Endocrine disorder resulting from insulin dysregulation.", 
      fullDescription: "EMS is a systemic endocrine disorder characterized by three main features: regional or general adiposity (obesity), insulin dysregulation, and a predisposition to laminitis. In EMS-affected horses, the body becomes resistant to the effects of insulin, leading to high levels of insulin in the blood (hyperinsulinemia). This metabolic state is extremely dangerous as high insulin levels are a direct trigger for laminitis—a painful and potentially devastating inflammation of the laminae within the horse's hoof that can lead to permanent structural damage.", 
      homeCare: "Weight management is the primary defense. This includes 'soaking' hay in water for 30-60 minutes to remove excess non-structural carbohydrates (sugars) and using grazing muzzles to limit intake of lush grass. Implementing a consistent, low-intensity exercise program for sound horses helps improve insulin sensitivity significantly.", 
      partners: "We support the Animal Health Foundation (AHF) and their dedicated research into the triggers of laminitis caused by metabolic issues." 
    },
    { 
      id: "fip", 
      title: "Feline Infectious Peritonitis (FIP)", 
      shortDesc: "A viral disease caused by certain strains of feline coronavirus.", 
      fullDescription: "FIP is a viral disease of cats caused by certain strains of a virus called the feline coronavirus. While most cats carry the enteric form of the virus without issue, in a small percentage of cases, the virus undergoes a specific mutation within the cat's own body. This mutated virus then infects white blood cells, which spread the infection throughout the cat's body, triggering an intense inflammatory reaction in the organs. It typically presents in two forms: 'Wet' (effusive), causing fluid buildup in the abdomen or chest, and 'Dry' (non-effusive), causing granulomas in various organs.", 
      homeCare: "Strict monitoring of appetite and activity levels is crucial. Maintaining a clean, low-stress household can help support the immune system. For cats undergoing modern antiviral treatments, ensuring high-calorie nutrition and liver support supplements is often recommended by specialists.", 
      partners: "We donate to the FIP Warriors fund and research initiatives at UC Davis School of Veterinary Medicine." 
    }
  ];

  useEffect(() => {
    const handleScroll = () => setIsScrolled(window.scrollY > 20);
    const handleClickOutside = (event) => {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target)) {
        setShowDesktopDropdown(false);
      }
    };
    window.addEventListener('scroll', handleScroll);
    document.addEventListener('mousedown', handleClickOutside);
    return () => {
      window.removeEventListener('scroll', handleScroll);
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, []);

  const navigateTo = (page) => {
    setCurrentPage(page);
    setSelectedDisease(null);
    setSelectedTapestry(null);
    setIsMenuOpen(false);
    setShowDesktopDropdown(false);
    window.scrollTo(0, 0);
  };

  const menuItems = [
    { id: 'tapestries', label: 'Our Tapestries', icon: LayoutGrid },
    { id: 'research', label: 'Animal Health Research', icon: Search },
    { id: 'donations', label: 'Donations & Progress', icon: Heart },
    { id: 'custom', label: 'Custom Tapestry', icon: Scissors },
  ];

  const CrochetImage = ({ src, alt, className }) => (
    <div className={`relative overflow-hidden bg-white flex items-center justify-center ${className}`}>
      <div className="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/linen-2.png')] opacity-10 z-10 pointer-events-none" />
      <img 
        src={src} 
        alt={alt}
        className="w-full h-full object-contain grayscale"
        style={{ 
          filter: 'brightness(0) contrast(1000%) url(#crochetFilter)',
          opacity: 1
        }}
      />
      <div className="absolute inset-0 pointer-events-none z-20"
           style={{ backgroundImage: 'radial-gradient(circle, rgba(0,0,0,0.02) 1px, transparent 1px)', backgroundSize: '5px 5px' }} />
    </div>
  );

  const HomeSection = () => (
    <div className="animate-in fade-in duration-700">
      <section className="relative h-[85vh] flex items-center justify-center overflow-hidden bg-[#fdfaf6]">
        <div className="absolute inset-0 z-0 opacity-10">
            <div className="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/natural-paper.png')]" />
        </div>
        <div className="relative z-10 text-center px-6 max-w-4xl">
          <span className="inline-block px-4 py-1.5 mb-6 text-xs font-bold tracking-widest text-emerald-800 uppercase bg-emerald-100/50 rounded-full border border-emerald-200">
            Nature-Inspired Fiber Arts
          </span>
          <h1 className="text-5xl md:text-7xl font-serif text-stone-800 mb-6 leading-tight">
            Tapestries with an <span className="italic text-orange-800 font-normal underline decoration-orange-200 underline-offset-8">Earthbound Soul</span>
          </h1>
          <p className="text-lg md:text-xl text-stone-600 mb-10 max-w-2xl mx-auto leading-relaxed">
            Every stitch supports animal health research and conservation efforts. Experience art that heals.
          </p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center">
            <button onClick={() => navigateTo('custom')} className="px-8 py-4 bg-emerald-900 text-white rounded-full hover:bg-emerald-950 transition-all flex items-center justify-center gap-2 group shadow-xl">
              Custom Commissions <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </button>
            <button onClick={() => navigateTo('donations')} className="px-8 py-4 bg-white text-emerald-900 rounded-full hover:bg-stone-50 transition-all border-2 border-emerald-900/10 font-bold">
              Support Our Mission
            </button>
          </div>
        </div>
      </section>

      <section className="py-24 px-6 bg-[#f7f3ee] border-y border-stone-200">
        <div className="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
          <div className="relative">
            <div className="aspect-square bg-emerald-900 rounded-3xl rotate-3 absolute inset-0 opacity-10" />
            <img 
              src="https://images.unsplash.com/photo-1584992236310-6edddc08acff?auto=format&fit=crop&q=80&w=800" 
              className="rounded-3xl shadow-2xl relative z-10 grayscale" 
              alt="Artisan working"
            />
          </div>
          <div>
            <div className="inline-flex items-center gap-2 text-orange-800 font-bold tracking-widest uppercase text-xs mb-4">
              <ScrollText className="w-4 h-4" /> My Story
            </div>
            <h2 className="text-4xl font-serif text-stone-800 mb-6">Hand-Crafted with Purpose</h2>
            <div className="space-y-4 text-stone-600 leading-relaxed text-lg">
              <p>Soul of Crochet began in a small garden studio, born from a deep love for the rhythm of the hook and the quiet strength of the natural world.</p>
              <p>Every piece I create is more than just decoration; it's a contribution to the health and safety of the creatures who inspire us every day.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  );

  const TapestryGallery = () => {
    if (selectedTapestry) {
      const currentPrice = Math.round(selectedTapestry.basePrice * sizeMultipliers[detailSize]);
      return (
        <div className="pt-32 pb-24 px-6 max-w-6xl mx-auto animate-in fade-in duration-500">
          <button onClick={() => setSelectedTapestry(null)} className="flex items-center gap-2 text-emerald-800 font-bold mb-10 hover:gap-3 transition-all">
            <ArrowLeft className="w-4 h-4" /> Back to Collection
          </button>
          <div className="grid lg:grid-cols-2 gap-16 items-start">
            <div className="bg-white p-12 rounded-[3rem] border border-stone-100 shadow-2xl">
              <CrochetImage src={selectedTapestry.img} alt={selectedTapestry.name} className="aspect-square rounded-2xl p-4" />
            </div>
            <div className="space-y-10">
              <div>
                <span className="text-xs font-bold uppercase tracking-widest text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full">{selectedTapestry.species}</span>
                <h1 className="text-4xl md:text-5xl font-serif text-stone-800 mt-4">{selectedTapestry.name}</h1>
                <p className="text-stone-500 mt-6 text-lg leading-relaxed">A high-contrast black silhouette on organic white cotton. This piece captures the silhouette of the {selectedTapestry.species.toLowerCase()} using a detailed crochet-style stitch technique.</p>
              </div>
              <div className="space-y-6">
                <h3 className="text-xs font-bold uppercase tracking-widest text-stone-400">Select Dimensions</h3>
                <div className="grid grid-cols-3 gap-4">
                  {Object.keys(sizeMultipliers).map((size) => (
                    <button key={size} onClick={() => setDetailSize(size)} className={`p-5 rounded-2xl border-2 transition-all flex flex-col items-center gap-1 ${detailSize === size ? 'border-emerald-800 bg-emerald-50' : 'border-stone-100 hover:border-emerald-200'}`}>
                      <span className="text-sm font-bold uppercase">{size}</span>
                      <span className="text-[10px] text-stone-400">{sizeLabels[size]}</span>
                    </button>
                  ))}
                </div>
              </div>
              <div className="pt-6 border-t border-stone-100 flex items-end justify-between">
                <div>
                  <span className="text-stone-400 text-xs font-bold uppercase block mb-1">Total Investment</span>
                  <span className="text-4xl font-serif text-emerald-900">${currentPrice}</span>
                </div>
                <button className="px-10 py-5 bg-emerald-900 text-white rounded-full font-bold shadow-xl">Reserve Piece</button>
              </div>
              <div className="bg-orange-50/50 p-6 rounded-2xl border border-orange-100 flex gap-4">
                <Heart className="w-6 h-6 text-orange-700 flex-shrink-0" />
                <p className="text-sm text-orange-900">A portion of this purchase is directly applied to our active animal research funds.</p>
              </div>
            </div>
          </div>

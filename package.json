              <h2 className="text-2xl font-serif mb-6 flex items-center gap-3 text-emerald-800 border-b pb-4"><Microscope className="w-6 h-6"/> Clinical Understanding</h2>
              <p className="text-stone-600 leading-relaxed text-lg">{selectedDisease.fullDescription}</p>
            </section>
            <section className="bg-orange-50/40 p-10 rounded-3xl border border-orange-100 shadow-sm">
              <h2 className="text-2xl font-serif mb-6 flex items-center gap-3 text-orange-800 border-b border-orange-200/50 pb-4"><Home className="w-6 h-6"/> At Home Care & Support</h2>
              <p className="text-stone-700 leading-relaxed text-lg italic">{selectedDisease.homeCare}</p>
            </section>
            <section className="bg-emerald-900 text-white p-10 rounded-[2.5rem] shadow-xl relative overflow-hidden">
               <h2 className="text-2xl font-serif mb-4 flex items-center gap-2 text-emerald-100"><ShieldCheck className="w-6 h-6"/> Where We Donate</h2>
               <p className="text-emerald-50/90 leading-relaxed text-lg italic">"{selectedDisease.partners}"</p>
            </section>
          </div>
        </div>
      );
    }
    return (
      <div className="pt-32 pb-24 px-6 max-w-6xl mx-auto">
        <h1 className="text-4xl font-serif text-stone-800 mb-4">Animal Disease Research</h1>
        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
          {diseaseData.map((study) => (
            <div key={study.id} onClick={() => setSelectedDisease(study)} className="group bg-white p-8 rounded-[2rem] border border-stone-200 hover:border-emerald-200 hover:shadow-xl cursor-pointer transition-all">
              <div className="p-3 bg-stone-50 rounded-xl w-fit mb-4 text-emerald-800"><Stethoscope className="w-5 h-5" /></div>
              <h3 className="text-xl font-serif text-stone-800 mb-3 line-clamp-2">{study.title}</h3>
              <div className="mt-auto pt-4 flex items-center gap-2 text-emerald-800 text-xs font-bold uppercase tracking-widest">Read More <ArrowRight className="w-3 h-3 group-hover:translate-x-1" /></div>
            </div>
          ))}
        </div>
      </div>
    );
  };

  const DonationSection = () => (
    <div className="pt-32 pb-24 px-6 max-w-6xl mx-auto">
      <div className="text-center mb-16"><Heart className="w-12 h-12 text-orange-700 mx-auto mb-6" /><h1 className="text-4xl md:text-5xl font-serif text-stone-800 mb-4">Support The Mission</h1></div>
      <div className="grid lg:grid-cols-2 gap-12">
        <section className="bg-white p-10 rounded-[3rem] border border-stone-100 shadow-xl">
          <h2 className="text-2xl font-serif text-stone-800 mb-8 flex items-center gap-3"><CreditCard className="w-6 h-6 text-emerald-700" /> Community Giving</h2>
          <form className="space-y-6">
            <input type="number" className="w-full px-5 py-4 bg-stone-50 border border-stone-100 rounded-2xl text-xl font-bold" placeholder="25" />
            <select className="w-full px-5 py-4 bg-stone-50 border border-stone-100 rounded-2xl outline-none"><option>Wildlife Rescue</option><option>Disease Research</option></select>
            <button type="button" className="w-full py-5 bg-emerald-900 text-white rounded-2xl font-bold">Complete Donation</button>
          </form>
        </section>
        <section className="bg-[#f7f3ee] p-10 rounded-[3rem] border border-stone-200">
          <h2 className="text-2xl font-serif text-stone-800 mb-8 flex items-center gap-2"><Target className="w-6 h-6 text-orange-700" /> Funding Goals</h2>
          <div className="space-y-10">
            {Object.entries(progress).map(([key, val]) => (
              <div key={key} className="space-y-3">
                <div className="flex justify-between items-end"><span className="font-serif capitalize">{key}</span><span className="text-lg font-bold">${val} / $200</span></div>
                <input type="range" min="0" max={GOAL} disabled={!isAdmin} value={val} onChange={(e) => setProgress({...progress, [key]: parseInt(e.target.value)})} className={`w-full h-2 rounded-lg appearance-none bg-stone-200 ${isAdmin ? 'accent-orange-700 cursor-pointer' : 'accent-emerald-800'}`} />
              </div>
            ))}
          </div>
          {isAdmin ? <button onClick={() => setIsAdmin(false)} className="mt-8 text-xs font-bold text-orange-800">Exit Admin</button> : <button onClick={() => setIsAdmin(true)} className="mt-8 text-[10px] text-stone-300">Admin Mode</button>}
        </section>
      </div>
    </div>
  );

  const CustomSection = () => (
    <div className="pt-32 pb-24 px-6 max-w-5xl mx-auto">
      <h1 className="text-4xl md:text-5xl font-serif text-stone-800 mb-12">Commission Your Tapestry</h1>
      <div className="grid lg:grid-cols-5 gap-12">
        <form className="lg:col-span-3 space-y-8 bg-white p-10 rounded-[2.5rem] border border-stone-100 shadow-xl">
          <div className="grid md:grid-cols-2 gap-6">
            <input type="text" className="w-full px-5 py-4 bg-[#fdfaf6] border border-stone-200 rounded-2xl outline-none" placeholder="Your Name" />
            <input type="email" className="w-full px-5 py-4 bg-[#fdfaf6] border border-stone-200 rounded-2xl outline-none" placeholder="Email" />
